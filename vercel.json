{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public", // <-- IMPORTANT: MATCHES YOUR VITE CONFIG
        "buildCommand": "npm run build:client"
      }
    },
    {
      "src": "server/index.ts",
      "use": "@vercel/node",
      "config": {
        "buildCommand": "npm run build:server"
      }
    }
  ],
  "rewrites": [
    {
      // 1. Catches all requests to your API (e.g., /api/data)
      "source": "/api/(.*)", 
      "destination": "server/index.ts" 
    },
    { 
      // 2. Catches everything else (including /, /page-1, /page-2) 
      // and routes it to the static index.html file in the client's output folder
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ]
}
