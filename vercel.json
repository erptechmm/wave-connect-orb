{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        // --- CORRECTED OUTPUT DIRECTORY ---
        "distDir": "dist/public", 
        "buildCommand": "npm run build:client"
      }
    },
    {
      "src": "server/index.ts",
      "use": "@vercel/node",
      "config": {
        "buildCommand": "npm run build:server"
      }
    }
  ],
  "rewrites": [
    {
      // 1. Catches API requests and routes them to the Serverless Function
      "source": "/api/(.*)", 
      "destination": "server/index.ts"
    },
    { 
      // 2. Catches everything else and routes it to the static index.html
      // This uses the file found inside the corrected "dist/public" folder
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ]
}
